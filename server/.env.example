# База данных MySQL (на Railway эти переменные создаются автоматически)
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=flowtrack

# Секрет для токенов входа — любая длинная случайная строка
JWT_SECRET=

# Ключ шифрования описаний операций (AES-256). 64 hex-символа. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ВАЖНО: сохрани его в надёжном месте — без него зашифрованные данные не прочитать.
DATA_KEY=

# Срок жизни токена входа (по умолчанию 1d)
# JWT_EXPIRES=1d

# Ключ Claude API (console.anthropic.com). Без него работает словарь мерчантов и шаблонные подсказки.
ANTHROPIC_API_KEY=
# Модели можно поменять при желании
# AI_MODEL_FAST=claude-haiku-5-5
# AI_MODEL=claude-sonnet-5-5

# Часовой пояс для «сегодня»
APP_TZ=Asia/Almaty

# Адрес фронтенда (через запятую, если несколько). Пусто = разрешить всем.
CORS_ORIGIN=
